# Optional: true forces local demo mode, even if Supabase is configured.
# Empty/false uses Supabase when valid credentials are supplied, otherwise demo.
NEXT_PUBLIC_DEMO_MODE=

# Required only for shared rooms. These are PUBLIC browser credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alternative to the publishable key (JWT with role=anon):
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional for local URL/ID playback; required for search and video metadata.
# Restrict this PUBLIC key to YouTube Data API v3 and your HTTP referrers.
NEXT_PUBLIC_YOUTUBE_API_KEY=

# Never put service_role, sb_secret_, database passwords, or private keys here.
# Restart npm run dev after editing .env.local; rebuild production deployments.
